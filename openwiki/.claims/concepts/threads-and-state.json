  "claims": [
    {
      "id": "claim_59daaaa8396044a0ab47378f78878e79",
      "statement": "agent/thread_ids.py is the single home for deterministic thread-id derivation, and every id is a cross-process routing contract that webhooks, the dashboard, and the reviewer each re-derive from the same external identifiers to find an existing thread, so changing a formula orphans live threads.",
      "evidence": [
        {
          "resource": "repo://agent/thread_ids.py#L1-L36",
          "version": "repo-lines-v1:sha256:7427ac60fac29abde683855df98f82a505ed476b7cd006637c7ef5096234441a:"
        }
      ]
    },
    {
      "id": "claim_3681e87a4b05434faa1958c0750175bb",
      "statement": "Thread ids are derived either as URL-namespaced UUIDv5 (Slack, PR-comment, reviewer, review-style, baby-sit-lock) via uuid.uuid5(NAMESPACE_URL, key), or as a SHA-256-derived UUID (Linear and GitHub issue ids) via _sha256_uuid.",
      "evidence": [
        {
          "resource": "repo://agent/thread_ids.py#L24-L71",
          "version": "repo-lines-v1:sha256:47e64c411a00dc21b68edea904aa3cb678530d6c425e02fbbe3b7edef9517a6d:"
        }
      ]
    },
    {
      "id": "claim_fdc9da1c1d8f4476a26fbd82626520de",
      "statement": "reviewer_thread_id derives a reviewer thread from {owner}/{repo}/pr/{pr_number}/reviewer, a namespace distinct from pr_comment_thread_id's {owner}/{repo}/pr/{pr_number}, so a PR's reviewer thread and agent thread never collide.",
      "evidence": [
        {
          "resource": "repo://agent/thread_ids.py#L40-L46",
          "version": "repo-lines-v1:sha256:2b932a387e541a31d145830077189c94edc154746e9d06887fbf6392d7ddd0a9:"
        }
      ]
    },
